CURSOR_API_KEY=crsr_YOUR_KEY_HERE

# 可选（默认值如下）
# CCA_HOST=127.0.0.1
# CCA_ADAPTER_PORT=4011
# CCA_SONNET_MODEL=grok-4.6
# CCA_OPUS_MODEL=grok-4.6
# CCA_HAIKU_MODEL=grok-4.5
# CCA_SYSTEM_MAX=12000
# CCA_TOOL_DESC_MAX=800
# CCA_TOOL_RESULT_MAX=24000
# CCA_PROMPT_MSG_MAX=12000
# CCA_TURN_TIMEOUT=600
# CCA_EXEC_TIMEOUT=600
# CCA_SESSION_TTL=1800
# CCA_PERMISSION_MODE=bypassPermissions   # 改 manual 则恢复 CC 逐条确认
# CCA_CONTEXT_HINT=                       # 设空关闭；默认仅提醒省上下文

# 模型路由（任务类型自动选择）
# CCA_MODEL_FAST=composer-2.5             # 短问答（无 tools 且 prompt ≤500 字符）
# CCA_MODEL_SMART=grok-4.6                # 带工具 / 长 prompt

# 预热（启动期把冷启动挪出请求路径）
# CCA_PREWARM=1                           # 总开关；0 全关
# CCA_PREWARM_AGENT=1                     # 0 只热 bridge 不建 agent
# CCA_PREWARM_SEND=1                      # 真实 send 一次（~9s 启动期），首个请求首 token 7.4s→2.8s
# CCA_PREWARM_WAIT=1                      # 启动等预热完成（≤25s）

# 历史与分叉
# CCA_HISTORY_TURNS=6                     # 首轮/重建带给 Cursor 的历史轮次
# CCA_HISTORY_TURNS_COMPACT=10            # compact 续聊时多带
# CCA_ALLOW_WORKSPACE_SWITCH=0            # 1 允许 :4011 静默切换工作区（烟测用）
# CCA_DUMP_REQUESTS=                      # 1 时请求元数据落 runtime/adapter-requests.jsonl（调试用）
