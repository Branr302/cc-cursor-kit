#!/usr/bin/env bash
# 启动 SDK 适配器（上游：Cursor SDK 长会话 + customTools 结构化桥）
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
RUNTIME="${CCA_RUNTIME:-$ROOT/runtime}"
mkdir -p "$RUNTIME"

ENV_FILE="${CCA_ENV:-$ROOT/.env}"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

HOST="${CCA_HOST:-127.0.0.1}"
PORT="${CCA_ADAPTER_PORT:-4011}"
PY="$ROOT/adapter/.venv/bin/python"

if [ ! -x "$PY" ]; then
  echo "缺少 adapter venv，正在执行 $ROOT/bin/setup …"
  bash "$ROOT/bin/setup"
fi
if [ ! -x "$PY" ]; then
  echo "❌ setup 后仍无 $PY" >&2
  exit 1
fi
if [ -z "${CURSOR_API_KEY:-}" ]; then
  echo "❌ 缺少 CURSOR_API_KEY（写进 $ROOT/.env）" >&2
  exit 1
fi

# 规范化 workspace（current_workspace() 优先读 marker）；冲突时先别改写 marker
if [ -n "${CCA_WORKSPACE:-}" ] && [ -d "$CCA_WORKSPACE" ]; then
  DESIRED="$(cd "$CCA_WORKSPACE" && pwd)"
else
  DESIRED="$ROOT"
fi
export CCA_WORKSPACE="${DESIRED}"
MARKER="$RUNTIME/workspace"
OLD_WS=""
if [ -f "$MARKER" ]; then
  OLD_WS="$(tr -d '\n' <"$MARKER" || true)"
fi

health_payload() {
  curl -sf --max-time 2 "http://${HOST}:${PORT}/health" 2>/dev/null || true
}

health_ok() {
  curl -sf --max-time 2 "http://${HOST}:${PORT}/health" >/dev/null 2>&1
}

write_workspace_marker() {
  printf '%s\n' "${DESIRED}" >"$MARKER"
}

if health_ok; then
  LIVE_WS="$(health_payload | python3 -c 'import sys,json
try:
  print((json.load(sys.stdin).get("workspace") or "").strip())
except Exception:
  print("")' 2>/dev/null || true)"
  EFFECTIVE_OLD="${LIVE_WS:-$OLD_WS}"
  if [ -n "${EFFECTIVE_OLD}" ] && [ "${EFFECTIVE_OLD}" != "${DESIRED}" ]; then
    if [ "${CCA_ALLOW_WORKSPACE_SWITCH:-0}" = "1" ]; then
      # 注意：macOS bash 3.2 下变量紧贴中文要用 ${VAR}
      echo "workspace 变更: ${EFFECTIVE_OLD} -> ${DESIRED}, 允许切换并重启 adapter"
      bash "$ROOT/bin/adapter-stop"
    else
      echo "❌ :${PORT} 正被 workspace=${EFFECTIVE_OLD} 占用，拒绝静默切换到 ${DESIRED}" >&2
      echo "   本 kit 默认单开。若要并行多项目，请另开端口，例如：" >&2
      echo "   CCA_ADAPTER_PORT=4013 CCA_RUNTIME=$ROOT/runtime/p2 $ROOT/bin/cc" >&2
      echo "   烟测/明确接管才设 CCA_ALLOW_WORKSPACE_SWITCH=1" >&2
      # 纵深：任何外部预写污染了 marker，都恢复成 /health 真值
      printf '%s\n' "${EFFECTIVE_OLD}" >"$MARKER"
      exit 1
    fi
  else
    write_workspace_marker
    echo "✅ 适配器已在 ${HOST}:${PORT} 运行（/health 正常）· workspace=${DESIRED}"
    exit 0
  fi
fi

write_workspace_marker

if command -v lsof >/dev/null 2>&1 && lsof -iTCP:"${PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "❌ 端口 ${PORT} 已被占用，但 /health 未通过。请换 CCA_ADAPTER_PORT 或先 ./bin/adapter-stop" >&2
  exit 1
fi

export CCA_HOST="${HOST}"
export CCA_ADAPTER_PORT="${PORT}"
rm -f "$RUNTIME/prewarm.status"

# 日志截断：超 10MB 时保留尾部 2MB（长期运行防无限增长；启动时做一次，零运行期成本）
if [ -f "$RUNTIME/adapter.log" ]; then
  LOG_SIZE=$(stat -f%z "$RUNTIME/adapter.log" 2>/dev/null || echo 0)
  if [ "$LOG_SIZE" -gt 10485760 ]; then
    tail -c 2097152 "$RUNTIME/adapter.log" > "$RUNTIME/adapter.log.tmp" && mv "$RUNTIME/adapter.log.tmp" "$RUNTIME/adapter.log"
    echo "[cc-adapter] log truncated at startup (was ${LOG_SIZE}B)" >> "$RUNTIME/adapter.log"
  fi
fi

echo "启动 cc-adapter  @ http://${HOST}:${PORT}  upstream=cursor-sdk workspace=${DESIRED}"
# 双 fork + setsid：避免被 Cursor agent 壳层收尸（单纯 nohup 不够）
"$PY" - "$PY" "$ROOT/adapter/server.py" "$RUNTIME/adapter.pid" "$RUNTIME/adapter.log" <<'PY'
import os, sys
py, script, pid_path, log_path = sys.argv[1:5]
if os.fork() > 0:
    raise SystemExit(0)
os.setsid()
if os.fork() > 0:
    raise SystemExit(0)
log = open(log_path, "a", buffering=1)
os.dup2(log.fileno(), 1)
os.dup2(log.fileno(), 2)
try:
    os.close(0)
except OSError:
    pass
with open(pid_path, "w", encoding="utf-8") as f:
    f.write(str(os.getpid()))
os.execv(py, [py, script])
PY

for _ in $(seq 1 50); do
  if health_ok; then
    if [ "${CCA_PREWARM_WAIT:-1}" != "0" ]; then
      # 等后台预热把 bridge/custom-tools/send 冷启动做完；失败也不阻塞可用性。
      # prewarm send 后总时长约 13-17s，窗口留到 25s。
      for _ in $(seq 1 100); do
        [ -f "$RUNTIME/prewarm.status" ] && break
        sleep 0.25
      done
      if [ -f "$RUNTIME/prewarm.status" ]; then
        echo "预热: $(tr -d '\n' <"$RUNTIME/prewarm.status")"
      else
        echo "预热未完成，先继续（后台仍在跑）"
      fi
    fi
    echo "✅ 已启动 (PID $(cat "$RUNTIME/adapter.pid")) · 日志 $RUNTIME/adapter.log"
    exit 0
  fi
  sleep 0.2
done

echo "❌ 启动超时（/health 未就绪），见 $RUNTIME/adapter.log" >&2
exit 1
